# Copy to .env and fill in locally. NEVER commit .env.
# The key belongs here and nowhere else - not in the game, not in a config that ships.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Spend. These are OUR stops; Google's prepay balance sits behind them.
MONTHLY_CAP_USD=15
DAILY_CAP_USD=0.75

# The lever that decides whether the budget buys 69 conversations a day or 36.
# Leave unset until the thinking controls for this model are verified in its own docs.
MAX_OUTPUT_TOKENS=512
# THINKING_BUDGET=

# 1 = never call Google, answer with canned lines. For client tests.
CHAT_MOCK=0
# 1 = the kill switch. Answers unavailable, calls nothing.
CHAT_DISABLED=0

PER_IP_PER_MINUTE=12
UPSTREAM_TIMEOUT_MS=20000
PORT=8787
BUDGET_FILE=./.state/budget.json
