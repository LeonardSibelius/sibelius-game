// Depot 5249381 "Leonard Sibelius Content" — the only depot on app 5249380.
//
// contentroot is NOT repeated here. It is set once in app_build_5249380.vdf and
// inherited, so there is one place to change when the build folder changes version.
//
// ---------------------------------------------------------------------------
// WHY THE .pdb EXCLUSION IS NOT HOUSEKEEPING.
//
// SibeliusGame-Win64-Shipping.pdb is 330 MB — debug symbols for the shipping binary. It
// is 4% of the archive, it is useless to a player, and without this line every customer
// downloads it and every upload pushes it. It is the same shape of mistake as the
// Chromium screen that v1.1.3 removed: 334 MB shipping for something nobody could use.
//
// Keep the .pdb in the LOCAL archive. It is what turns a crash report from a player into
// a line number, and Steam is not the place to store it.
//
// Manifest_DebugFiles_Win64.txt is excluded for the same reason — it only lists the
// debug files that are no longer going up. The UFS and NonUFS manifests DO ship;
// they are part of how the game finds its own content.

"DepotBuild"
{
	"DepotID"		"5249381"

	"FileMapping"
	{
		"LocalPath"		"*"
		"DepotPath"		"."
		"recursive"		"1"
	}

	"FileExclusion"		"*.pdb"
	"FileExclusion"		"Manifest_DebugFiles_Win64.txt"
}
